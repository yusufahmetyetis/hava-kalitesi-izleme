# Kurulum:  cp .env.example .env   sonra aşağıdaki ZORUNLU alanları doldur.
#
# docker compose bu dosyadan yalnızca üç değişkeni okur:
#   WAQI_TOKEN, DB_USER, DB_PASSWORD
# Geri kalanı compose zaten servis servis kendisi veriyor (bkz. docker-compose.yml).

# ---------- ZORUNLU ----------

# WAQI (aqicn.org) API token'ı. Ücretsiz: https://aqicn.org/data-platform/token/
# Boş bırakılırsa aqi-publisher WAQI'den veri çekemez ve dashboard boş kalır.
WAQI_TOKEN=

# TimescaleDB superuser'ı. Kullanıcı adı serbest, yeni kurulumda bu adla oluşturulur.
# DB_PASSWORD BOŞ BIRAKILAMAZ — postgres imajı boş şifreyle başlamayı reddeder:
#   "Database is uninitialized and superuser password is not specified"
DB_USER=aqi
DB_PASSWORD=degistir-beni

# ---------- Yalnızca Docker DIŞINDA çalıştırırken ----------
# Örn. host'tan `python -m mqtt.backfill_sim` çalıştırırken shared/db.py bunları okur.
# Container'ları ETKİLEMEZ: compose her servise DB_HOST=timescaledb, MQTT_BROKER=mosquitto
# ve DB_NAME=aqi_db (enerji servislerinde energy_demo) değerlerini kendisi geçiyor.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aqi_db
MQTT_BROKER=localhost
MQTT_PORT=1883
